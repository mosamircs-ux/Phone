<resources>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="DialpadButtonStyle">
        <item name="android:background">@drawable/pulse_dialpad_pill</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="DialpadNumberStyle">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/dialpad_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>

    <style name="DialpadLetterStyle">
        <item name="android:textSize">@dimen/dialpad_letters_text_size</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:alpha">0.85</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>

</resources>
